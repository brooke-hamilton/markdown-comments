{
  "name": "markdown-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Selection-based Markdown review canvas for the GitHub Copilot app",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "esbuild ui.mjs --bundle --format=esm --outdir=dist --entry-names=app",
    "build:release": "node scripts/build-release.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.3",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2"
  }
}
